{
  // Отдельный Worker совместной работы (доски + видеозвонки).
  // Worker с уроками (flashcards-api) не затрагивается.
  "name": "flashcards-collaboration",
  "main": "worker.js",
  "compatibility_date": "2026-10-16",

  // Durable Object: по одной комнате на доску, синхронизация через WebSocket
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARDS",
        "class_name": "BoardRoom"
      }
    ]
  },

  // Регистрация класса Durable Object с SQLite-хранилищем
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],

  "vars": {
    // Домены, которым разрешено обращаться к Worker'у (через заголовок Origin)
    "ALLOWED_ORIGINS": "https://imadji.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500",

    // Cloudflare Calls (RealtimeKit): Account ID из `wrangler whoami`
    "CLOUDFLARE_ACCOUNT_ID": "fdbaddc8ecf2a4827a85d8632aea6909",

    // App ID приложения Cloudflare Calls — вписывается после создания приложения
    "REALTIMEKIT_APP_ID": "",

    // Имена пресетов участников (создаются в настройках приложения Calls)
    "REALTIMEKIT_HOST_PRESET": "host",
    "REALTIMEKIT_STUDENT_PRESET": "student"
  }

  // Секреты задаются командой (НЕ пишутся в этот файл):
  //   npx wrangler secret put TEACHER_TOKEN
  //   npx wrangler secret put REALTIMEKIT_API_TOKEN
}